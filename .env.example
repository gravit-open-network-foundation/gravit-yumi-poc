# ============================================================================
# Gravit Epistemic Verifier - Environment Configuration
# ============================================================================

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8080
WEBSOCKET_PORT=8081

# IMPORTANT: Change this in production!
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://your-domain.com

# API Key (REQUIRED in production - generate a secure random string)
GRAVIT_API_KEY=change-me-in-production-please-use-a-secure-random-string

# Verification Thresholds
SEMANTIC_THRESHOLD=0.7
POLICY_STRICTNESS=0.8
ADVERSARIAL_DETECTION_ENABLED=true
ADVERSARIAL_SENSITIVITY=0.7

# Trust Score Thresholds (0-255)
TRUST_APPROVE_THRESHOLD=217
TRUST_REVIEW_THRESHOLD=153

# ============================================================================
# LLM Configuration
# ============================================================================

LLM_PROVIDER=mock
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=500
LLM_TIMEOUT=30

# API Keys (only needed if provider != mock)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROK_API_KEY=

# ============================================================================
# Infrastructure
# ============================================================================

# Redis (generate a secure password for production)
REDIS_PASSWORD=redis123-change-me-in-production
REDIS_TTL_SECONDS=3600

# Audit Storage
AUDIT_STORAGE_PATH=./audit_logs
ENABLE_CRYPTOGRAPHIC_SIGNATURES=true

# Grafana
GRAFANA_PASSWORD=admin123-change-me-in-production

# Performance
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT_SECONDS=30
