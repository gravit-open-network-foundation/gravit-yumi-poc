# Gravit × Yumi PoC – Environment Variables

# ============================================
# LLM API Keys (choose one or more)
# ============================================

# xAI Grok (recommended)
GROK_API_KEY=your_grok_api_key_here

# OpenAI GPT-4
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================
# Gravit Configuration
# ============================================

GRAVIT_VERIFIER_URL=http://localhost:8080/v1/verify
GRAVIT_API_KEY=your_gravit_api_key_here

# ============================================
# Yumi Configuration (for integration)
# ============================================

YUMI_API_URL=https://api.yumi.finance/v1
YUMI_API_KEY=your_yumi_api_key_here
YUMI_CREDIT_ENGINE_ADDRESS=0x...

# ============================================
# Environment
# ============================================

ENVIRONMENT=development  # development, staging, production
LOG_LEVEL=INFO           # DEBUG, INFO, WARN, ERROR
